rules_version = '2';
// Deploy timestamp: 2026-03-26T01:52
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: collection-level read for Mission Control dashboard
    match /users/{userId} {
      // Any client can list users (needed for MC dashboard user counts)
      allow list: if true;
      // Individual user read/write requires auth
      allow get, write: if request.auth != null && request.auth.uid == userId;

      match /agents/{agentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Global config
    match /config/{configId} {
      allow read: if request.auth != null;
    }

    // Legacy missions
    match /missions/{missionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Threaded conversations
    match /conversations/{conversationId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Mission Control admin collections (read-only from client, written by Admin SDK)
    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /deals/{document=**} {
      allow read, write: if true;
    }

    match /clients/{document=**} {
      allow read, write: if true;
    }

    // Mission Control dashboard: read-only access for realtime listeners
    match /activity_log/{document=**} {
      allow read: if true;
    }

    match /leads/{document=**} {
      allow read: if true;
    }
  }
}
